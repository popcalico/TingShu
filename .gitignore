# 签名文件（切勿提交）
key.properties
*.jks
*.keystore

# 本地打包素材（含签名文件，不入库）
/打包数据/

# 本地调试脚本输出
/tool/*_out.txt

# 本地打包产物
/dist/

# 内部调研文档（含本机路径，不公开）
调研总结.md

# ---- 本项目补充（2026-11-22 准备开源时整理）----

# 归档安装包（每个 36MB×13，不入库）
/安装包/
/dist/

# 更新服务器的安装包（清单 version.json 可以入库当示例，apk 不行）
server/*.apk

# 本机环境脚本（含本机绝对路径）与 Android 本地 SDK 路径
env.sh
android/local.properties

# libmpv 的离线 jar 备份（12MB 第三方二进制，构建脚本会自动下载）
tools/media_kit_jars/

# Flutter 自动生成的插件清单
.flutter-plugins
.flutter-plugins-dependencies

# 本地诊断脚本可能吐出的输出
/tmp/
